@dp.message(F.text == "▶️ Запустить парсинг")
async def f_44(m: types.Message):
    uid = m.from_user.id
    jid = await get_job(uid)
    if jid:
        try:
            scheduler.get_job(jid)
            await m.answer("Уже запущено.")
            return
        except JobLookupError:
            await del_job(uid)
    accs = [a for a in await get_accounts(uid) if a["is_active"]]
    if not accs:
        await m.answer("Нет активных аккаунтов.")
        return
    ready = [a for a in accs if a["sources"] and a["target"]]
    if not ready:
        await m.answer("Ни у одного активного аккаунта нет источников и цели.")
        return
    await start_sched(uid)
    await m.answer("▶️ Парсинг запущен!", reply_markup=await main_kb(uid))


@dp.message(F.text == "⏹ Остановить парсинг")
async def f_45(m: types.Message):
    await stop_sched(m.from_user.id)
    await m.answer("⏹ Остановлено.", reply_markup=await main_kb(m.from_user.id))


@dp.message(F.text == "🔙 Назад")
async def f_46(m: types.Message):
    await m.answer("Главное меню:", reply_markup=await main_kb(m.from_user.id))


@dp.message()
async def f_47(m: types.Message):
    pass


async def main():
    logging.info("=== BOT STARTING ===")
    logging.info(f"BOT_TOKEN length: {len(BOT_TOKEN)}")
    await init_db()
    if not scheduler.running:
        scheduler.start()
    await restore_scheds()
    bot = Bot(token=BOT_TOKEN)
    await dp.start_polling(bot)


if __name__ == "__main__":
    asyncio.run(main())
