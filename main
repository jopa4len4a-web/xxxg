def src_kb(acc_id, sources):
    kb = []
    for i, s in enumerate(sources):
        kb.append([InlineKeyboardButton(text=f"❌ {s.get('title', s['id'])}", callback_data=f"src_del_{acc_id}_{i}")])
    kb.append([InlineKeyboardButton(text="📋 Выбрать из чатов", callback_data=f"src_pick_{acc_id}")])
    kb.append([InlineKeyboardButton(text="🔙 Назад", callback_data=f"acc_back_{acc_id}")])
    return InlineKeyboardMarkup(inline_keyboard=kb)


