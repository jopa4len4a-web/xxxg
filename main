def make_client(session_string):
    return TelegramClient(
        StringSession(session_string) if session_string else StringSession(),
        API_ID, API_HASH,
        device_model="PC 64bit",
        system_version="Windows 10",
        app_version="4.16.8",
        lang_code="ru",
        system_lang_code="ru",
    )


async def init_db():
    logging.info("init_db start")
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute('''CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY, username TEXT, partner_id INTEGER,
            invite_limit INTEGER DEFAULT 200, parse_limit INTEGER DEFAULT 500, delay REAL DEFAULT 1.5)''')
        await db.execute('''CREATE TABLE IF NOT EXISTS accounts (
            id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER, phone TEXT, username TEXT,
            session_string TEXT, is_active INTEGER DEFAULT 1, invited_count INTEGER DEFAULT 0,
            parsed_count INTEGER DEFAULT 0, sources TEXT DEFAULT '[]', target TEXT DEFAULT 'null')''')
        await db.execute('''CREATE TABLE IF NOT EXISTS queue (
            id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER, account_id INTEGER,
            target_id INTEGER, target_type TEXT, target_access_hash INTEGER, uid INTEGER,
            user_username TEXT, first_name TEXT, last_name TEXT, access_hash INTEGER,
            status TEXT DEFAULT 'pending', error TEXT)''')
        await db.execute('''CREATE TABLE IF NOT EXISTS invited (
            id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER, target_id INTEGER, uid INTEGER,
            UNIQUE(user_id, target_id, uid))''')
        await db.execute('''CREATE TABLE IF NOT EXISTS jobs (
            user_id INTEGER PRIMARY KEY, job_id TEXT)''')
        await db.commit()
    logging.info("init_db done")


async def ensure_user(uid, uname=None):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT user_id FROM users WHERE user_id = ?", (uid,))
        r = await cur.fetchone()
        if not r:
            await db.execute("INSERT INTO users (user_id, username) VALUES (?, ?)", (uid, uname))
        elif uname:
            await db.execute("UPDATE users SET username = ? WHERE user_id = ?", (uname, uid))
        await db.commit()


async def find_user(username):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT user_id FROM users WHERE LOWER(username) = LOWER(?)", (username,))
        r = await cur.fetchone()
        return r[0] if r else None


async def get_settings(uid):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT invite_limit, parse_limit, delay FROM users WHERE user_id = ?", (uid,))
        r = await cur.fetchone()
        if r:
            return {"invite_limit": r[0], "parse_limit": r[1], "delay": r[2]}
        return {"invite_limit": DEFAULT_INVITE_LIMIT, "parse_limit": DEFAULT_PARSE_LIMIT, "delay": DEFAULT_DELAY}


async def set_setting(uid, key, val):
    allowed = {"invite_limit", "parse_limit", "delay"}
    if key not in allowed:
        return
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute(f"UPDATE users SET {key} = ? WHERE user_id = ?", (val, uid))
        await db.commit()


async def get_accounts(uid):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute(
            "SELECT id, phone, username, session_string, is_active, invited_count, parsed_count, sources, target FROM accounts WHERE user_id = ?",
            (uid,))
        rows = await cur.fetchall()
        out = []
        for r in rows:
            try:
                sources = json.loads(r[7]) if r[7] else []
            except Exception:
                sources = []
            target = None
            if r[8] and r[8] != "null":
                try:
                    target = json.loads(r[8])
                except Exception:
                    target = None
            out.append({"id": r[0], "phone": r[1], "username": r[2], "session_string": r[3],
                        "is_active": bool(r[4]), "invited_count": r[5], "parsed_count": r[6],
                        "sources": sources, "target": target})
        return out


async def get_account(acc_id, uid):
    for a in await get_accounts(uid):
        if a["id"] == acc_id:
            return a
    return None


async def add_account(uid, phone, uname, sess):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("INSERT INTO accounts (user_id, phone, username, session_string) VALUES (?, ?, ?, ?)",
                         (uid, phone, uname, sess))
        await db.commit()
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT partner_id FROM users WHERE user_id = ?", (uid,))
        r = await cur.fetchone()
        partner = r[0] if r else None
        if partner:
            cur = await db.execute("SELECT id FROM accounts WHERE user_id = ? AND phone = ?", (partner, phone))
            if not await cur.fetchone():
                await db.execute("INSERT INTO accounts (user_id, phone, username, session_string) VALUES (?, ?, ?, ?)",
                                 (partner, phone, uname, sess))
                await db.commit()


async def toggle_acc(acc_id, uid, active):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE accounts SET is_active = ? WHERE id = ? AND user_id = ?",
                         (1 if active else 0, acc_id, uid))
        await db.commit()


async def save_sources(acc_id, uid, sources):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE accounts SET sources = ? WHERE id = ? AND user_id = ?",
                         (json.dumps(sources), acc_id, uid))
        await db.commit()


async def save_target(acc_id, uid, target):
    val = json.dumps(target) if target is not None else "null"
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE accounts SET target = ? WHERE id = ? AND user_id = ?", (val, acc_id, uid))
        await db.commit()


async def save_username(acc_id, uid, uname):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE accounts SET username = ? WHERE id = ? AND user_id = ?", (uname, acc_id, uid))
        await db.commit()


async def inc_parsed(acc_id, uid, d):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE accounts SET parsed_count = parsed_count + ? WHERE id = ? AND user_id = ?", (d, acc_id, uid))
        await db.commit()


async def inc_invited(acc_id, uid, d=1):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE accounts SET invited_count = invited_count + ? WHERE id = ? AND user_id = ?", (d, acc_id, uid))
        await db.commit()


async def del_account(acc_id, uid):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("DELETE FROM accounts WHERE id = ? AND user_id = ?", (acc_id, uid))
        await db.commit()


async def already_invited(uid, target_id, tg_id):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT 1 FROM invited WHERE user_id = ? AND target_id = ? AND uid = ?",
                               (uid, target_id, tg_id))
        return bool(await cur.fetchone())


async def already_pending(uid, target_id, tg_id):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute(
            "SELECT 1 FROM queue WHERE user_id = ? AND target_id = ? AND uid = ? AND status = 'pending'",
            (uid, target_id, tg_id))
        return bool(await cur.fetchone())


async def enqueue(uid, acc_id, target, u):
    if await already_invited(uid, target["id"], u["id"]):
        return False
    if await already_pending(uid, target["id"], u["id"]):
        return False
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute('''INSERT INTO queue (user_id, account_id, target_id, target_type,
            target_access_hash, uid, user_username, first_name, last_name, access_hash)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)''', (
            uid, acc_id, target["id"], target.get("type", "channel"), target.get("access_hash", 0),
            u["id"], u["username"], u["first_name"], u["last_name"], u["access_hash"]))
        await db.commit()
    return True


async def pop_batch(uid, limit=20):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute('''SELECT id, account_id, target_id, target_type, target_access_hash,
            uid, user_username, first_name, last_name, access_hash
            FROM queue WHERE user_id = ? AND status = 'pending' ORDER BY id LIMIT ?''', (uid, limit))
        rows = await cur.fetchall()
        return [{"id": r[0], "account_id": r[1], "target_id": r[2], "target_type": r[3],
                 "target_access_hash": r[4], "uid": r[5], "user_username": r[6],
                 "first_name": r[7], "last_name": r[8], "access_hash": r[9]} for r in rows]


async def set_status(qid, status, err=None):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE queue SET status = ?, error = ? WHERE id = ?", (status, err, qid))
        await db.commit()


async def mark_invited(uid, target_id, tg_id):
    async with aiosqlite.connect(DB_PATH) as db:
        try:
            await db.execute("INSERT OR IGNORE INTO invited (user_id, target_id, uid) VALUES (?, ?, ?)",
                             (uid, target_id, tg_id))
            await db.commit()
        except Exception:
            pass


async def clear_queue(uid):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("DELETE FROM queue WHERE user_id = ? AND status != 'invited'", (uid,))
        await db.commit()


async def stats(uid):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT status, COUNT(*) FROM queue WHERE user_id = ? GROUP BY status", (uid,))
        rows = await cur.fetchall()
        return {r[0]: r[1] for r in rows}


async def save_job(uid, jid):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("INSERT OR REPLACE INTO jobs (user_id, job_id) VALUES (?, ?)", (uid, jid))
        await db.commit()


async def get_job(uid):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT job_id FROM jobs WHERE user_id = ?", (uid,))
        r = await cur.fetchone()
        return r[0] if r else None


async def del_job(uid):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("DELETE FROM jobs WHERE user_id = ?", (uid,))
        await db.commit()


async def parse_source(client, src, limit):
    try:
        entity = await client.get_entity(src.get("id") or src.get("username"))
    except Exception as e:
        logging.warning(f"parse_source {src.get('title')}: {e}")
        return []
    if not isinstance(entity, tl_types.Channel):
        return []
    result = []
    offset = 0
    step = 200
    while len(result) < limit:
        try:
            part = await client(functions.channels.GetParticipantsRequest(
                channel=entity, filter=ChannelParticipantsSearch(''), offset=offset, limit=step, hash=0))
        except Exception as e:
            logging.warning(f"GetParticipants {src.get('title')}: {e}")
            break
        if not part or not part.users:
            break
        for u in part.users:
            if u.bot or not getattr(u, "username", None):
                continue
            if not getattr(u, "access_hash", None):
                continue
            result.append({"id": u.id, "username": u.username,
                           "first_name": u.first_name or "", "last_name": u.last_name or "",
                           "access_hash": u.access_hash})
            if len(result) >= limit:
                break
        offset += step
        if len(part.users) < step:
            break
    return result


async def is_in_target(client, target, tg_id):
    try:
        entity = await client.get_entity(target["id"])
        await client(functions.channels.GetParticipantRequest(channel=entity, participant=tg_id))
        return True
    except Exception:
        return False


async def invite(client, target, u):
    try:
        await client(AddContactRequest(
            id=InputPeerUser(u["id"], u["access_hash"]),
            first_name=u["first_name"] or u["username"] or "User",
            last_name=u["last_name"] or "", phone="", add_phone_privacy_exception=False))
    except FloodWaitError as e:
        await asyncio.sleep(e.seconds)
        return False, f"flood_contact_{e.seconds}s"
    except UserPrivacyRestrictedError:
        return False, "privacy_restricted"
    except Exception as e:
        logging.info(f"AddContact skip: {e}")

    try:
        if target["type"] == "channel":
            await client(InviteToChannelRequest(
                channel=InputPeerChannel(target["id"], target["access_hash"]),
                users=[InputPeerUser(u["id"], u["access_hash"])]))
        else:
            await client(AddChatUserRequest(
                chat_id=target["id"],
                user_id=InputPeerUser(u["id"], u["access_hash"]), fwd_limit=100))
        return True, "invited"
    except UserAlreadyParticipantError:
        return False, "already_participant"
    except UserNotMutualContactError:
        return False, "not_mutual_contact"
    except UserChannelsTooMuchError:
        return False, "target_channels_too_much"
    except ChatAdminRequiredError:
        return False, "no_admin_rights"
    except PeerFloodError:
        return False, "peer_flood"
    except FloodWaitError as e:
        await asyncio.sleep(e.seconds)
        return False, f"flood_invite_{e.seconds}s"
    except Exception as e:
        return False, f"error: {type(e).__name__}: {e}"


async def process(uid):
    settings = await get_settings(uid)
    accounts = [a for a in await get_accounts(uid) if a["is_active"]]
    if not accounts:
        return
    for acc in accounts:
        if not acc["sources"] or not acc["target"]:
            continue
        client = make_client(acc["session_string"])
        try:
            await client.start()
            total = 0
            for src in acc["sources"]:
                users = await parse_source(client, src, settings["parse_limit"])
                if not users:
                    continue
                for u in users:
                    if await is_in_target(client, acc["target"], u["id"]):
                        continue
                    if await enqueue(uid, acc["id"], acc["target"], u):
                        total += 1
            if total:
                await inc_parsed(acc["id"], uid, total)
        except Exception as e:
            logging.error(f"parse[{acc['phone']}]: {e}")
        finally:
            try:
                await client.disconnect()
            except Exception:
                pass

    batch = await pop_batch(uid, INVITE_BATCH)
    if not batch:
        return
    by_acc = {}
    for it in batch:
        by_acc.setdefault(it["account_id"], []).append(it)
    for acc_id, items in by_acc.items():
        acc = next((a for a in accounts if a["id"] == acc_id), None)
        if not acc:
            for it in items:
                await set_status(it["id"], "skipped", "account_inactive")
            continue
        if acc["invited_count"] >= settings["invite_limit"]:
            for it in items:
                await set_status(it["id"], "skipped", "daily_limit")
            continue
        client = make_client(acc["session_string"])
        try:
            await client.start()
            for it in items:
                if acc["invited_count"] >= settings["invite_limit"]:
                    await set_status(it["id"], "skipped", "daily_limit")
                    continue
                target = {"id": it["target_id"], "type": it["target_type"], "access_hash": it["target_access_hash"]}
                u = {"id": it["uid"], "username": it["user_username"], "first_name": it["first_name"],
                     "last_name": it["last_name"], "access_hash": it["access_hash"]}
                ok, reason = await invite(client, target, u)
                if ok:
                    await set_status(it["id"], "invited")
                    await mark_invited(uid, it["target_id"], it["uid"])
                    await inc_invited(acc_id, uid, 1)
                    acc["invited_count"] += 1
                else:
                    if reason in ("already_participant", "not_mutual_contact",
                                  "target_channels_too_much", "privacy_restricted",
                                  "no_admin_rights", "peer_flood"):
                        await set_status(it["id"], "skipped", reason)
                        await mark_invited(uid, it["target_id"], it["uid"])
                    else:
                        await set_status(it["id"], "failed", reason)
                await asyncio.sleep(settings["delay"])
        except Exception as e:
            logging.error(f"invite[{acc['phone']}]: {e}")
            for it in items:
                await set_status(it["id"], "failed", str(e))
        finally:
            try:
                await client.disconnect()
            except Exception:
                pass


async def run_process(uid):
    if uid in RUNNING:
        return
    RUNNING.add(uid)
    try:
        await process(uid)
    except Exception as e:
        logging.error(f"run_process[{uid}]: {e}")
    finally:
        RUNNING.discard(uid)


async def start_sched(uid):
    jid = await get_job(uid)
    if jid:
        try:
            scheduler.get_job(jid)
            return
        except JobLookupError:
            await del_job(uid)
    job = scheduler.add_job(run_process, "interval", seconds=PROCESS_INTERVAL,
                            args=[uid], id=f"proc_{uid}", replace_existing=True)
    await save_job(uid, job.id)


async def stop_sched(uid):
    jid = await get_job(uid)
    if jid:
        try:
            scheduler.remove_job(jid)
        except JobLookupError:
            pass
        await del_job(uid)


async def restore_scheds():
    logging.info("restore_scheds start")
    try:
        async with aiosqlite.connect(DB_PATH) as db:
            cur = await db.execute("SELECT user_id FROM jobs")
            for r in await cur.fetchall():
                await start_sched(r[0])
        logging.info("restore_scheds done")
    except Exception as e:
        logging.error(f"restore_scheds: {e}")


async def get_dialogs(acc, limit=200):
    client = make_client(acc["session_string"])
    out = []
    try:
        await client.start()
        dialogs = await client.get_dialogs(limit=limit)
        for d in dialogs:
            if not d.is_group and not d.is_channel:
                continue
            try:
                peer_id = utils.get_peer_id(d.entity)
                access_hash = getattr(d.entity, "access_hash", 0) or 0
                is_broadcast = bool(getattr(d.entity, "broadcast", False))
                is_megagroup = bool(getattr(d.entity, "megagroup", False))
                out.append({"id": peer_id, "access_hash": access_hash, "title": d.title or str(peer_id),
                            "username": getattr(d.entity, "username", None),
                            "type": "channel" if (is_broadcast or is_megagroup) else "chat"})
            except Exception:
                continue
    except Exception as e:
        logging.error(f"get_dialogs: {e}")
    finally:
        try:
            await client.disconnect()
        except Exception:
            pass
    return out


async def main_kb(uid):
    running = False
    jid = await get_job(uid)
    if jid:
        try:
            scheduler.get_job(jid)
            running = True
        except JobLookupError:
            running = False
    btn = "⏹ Остановить парсинг" if running else "▶️ Запустить парсинг"
    return ReplyKeyboardMarkup(keyboard=[
        [KeyboardButton(text="📋 Аккаунты")],
        [KeyboardButton(text="🤝 Партнёрство")],
        [KeyboardButton(text="⚙️ Настройки")],
        [KeyboardButton(text=btn)],
    ], resize_keyboard=True)


def accs_kb(accounts):
    kb = []
    for a in accounts:
        st = "✅" if a["is_active"] else "❌"
        un = f"@{a['username']}" if a["username"] else "без ника"
        kb.append([KeyboardButton(text=f"{st} {un} • {a['phone']}")])
    kb.append([KeyboardButton(text="➕ Добавить аккаунт")])
    kb.append([KeyboardButton(text="🔙 Назад")])
    return ReplyKeyboardMarkup(keyboard=kb, resize_keyboard=True)


