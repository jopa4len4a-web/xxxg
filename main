async def f_38(m: types.Message, st: FSMContext):
    try:
        v = int(m.text.strip())
        if v < 1 or v > 1000:
            raise ValueError
        await set_setting(m.from_user.id, "invite_limit", v)
        await m.answer(f"✅ Лимит инвайтов: {v}")
    except ValueError:
        await m.answer("Введите число 1–1000.")
    await st.clear()


