    accs = await get_accounts(m.from_user.id)
    if not accs:
        kb = ReplyKeyboardMarkup(keyboard=[[KeyboardButton(text="➕ Добавить аккаунт")],
                                           [KeyboardButton(text="🔙 Назад")]], resize_keyboard=True)
        await m.answer("Нет аккаунтов.", reply_markup=kb)
    else:
        await m.answer("Ваши аккаунты:", reply_markup=accs_kb(accs))


