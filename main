def prof_kb(acc_id):
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="👤 Имя", callback_data=f"prof_first_{acc_id}"),
         InlineKeyboardButton(text="📛 Фамилия", callback_data=f"prof_last_{acc_id}")],
        [InlineKeyboardButton(text="🔗 Юзернейм", callback_data=f"prof_user_{acc_id}"),
         InlineKeyboardButton(text="🖼 Аватар", callback_data=f"prof_av_{acc_id}")],
        [InlineKeyboardButton(text="🔙 Назад", callback_data=f"acc_back_{acc_id}")],
    ])


def partner_kb(has):
    kb = []
    if has:
        kb.append([InlineKeyboardButton(text="❌ Расторгнуть", callback_data="partner_unset")])
    else:
        kb.append([InlineKeyboardButton(text="➕ Привязать партнёра", callback_data="partner_link")])
    kb.append([InlineKeyboardButton(text="🔙 Назад", callback_data="back_main")])
    return InlineKeyboardMarkup(inline_keyboard=kb)


def settings_kb():
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="📊 Статистика", callback_data="set_stats")],
        [InlineKeyboardButton(text="📨 Лимит инвайтов в день", callback_data="set_inv_limit")],
        [InlineKeyboardButton(text="📥 Лимит парсинга за проход", callback_data="set_parse_limit")],
        [InlineKeyboardButton(text="⏸ Задержка между инвайтами (сек)", callback_data="set_delay")],
        [InlineKeyboardButton(text="🧹 Очистить очередь", callback_data="set_clear")],
        [InlineKeyboardButton(text="🔙 Назад", callback_data="back_main")],
    ])


class S_acc(StatesGroup):
    phone = State()
    code = State()
    password = State()


class S_partner(StatesGroup):
    username = State()


class S_prof(StatesGroup):
    first = State()
    last = State()
    uname = State()
    avatar = State()


class S_set(StatesGroup):
    inv_limit = State()
    parse_limit = State()
    delay = State()


