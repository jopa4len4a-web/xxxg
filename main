# ---------- ОЧЕРЕДЬ ----------
async def enqueue_user(user_id: int, source_account_id: int, target_account_id: int,
                       target_chat_id: int, target_chat_title: str, target_chat_type: str,
                       target_chat_access_hash: int, user_id_tg: int, username: str,
                       first_name: str, last_name: str, access_hash: int):
    async with aiosqlite.connect(DB_PATH) as db:
        # уже приглашён?
        cursor = await db.execute(
            "SELECT 1 FROM invited WHERE user_id = ? AND target_chat_id = ? AND user_telegram_id = ?",
            (user_id, target_chat_id, user_id_tg)
        )
        if await cursor.fetchone():
            return False
        # уже в очереди?
        cursor = await db.execute(
            "SELECT 1 FROM queue WHERE user_id = ? AND target_chat_id = ? AND user_telegram_id = ? AND status = 'pending'",
            (user_id, target_chat_id, user_id_tg)
        )
        if await cursor.fetchone():
            return False
        await db.execute('''
            INSERT INTO queue (user_id, source_account_id, target_account_id,
                target_chat_id, target_chat_title, target_chat_type, target_chat_access_hash,
                user_telegram_id, user_username, user_first_name, user_last_name, user_access_hash)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        ''', (user_id, source_account_id, target_account_id,
              target_chat_id, target_chat_title, target_chat_type, target_chat_access_hash,
              user_id_tg, username, first_name, last_name, access_hash))
        await db.commit()
        return True

async def pop_queue_batch(user_id: int, limit: int = 20):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute(
            "SELECT id, source_account_id, target_account_id, target_chat_id, target_chat_title, target_chat_type, target_chat_access_hash, user_telegram_id, user_username, user_first_name, user_last_name, user_access_hash FROM queue WHERE user_id = ? AND status = 'pending' ORDER BY id LIMIT ?",
            (user_id, limit)
        )
        rows = await cursor.fetchall()
        return [{"id": r[0], "source_account_id": r[1], "target_account_id": r[2],
                 "target_chat_id": r[3], "target_chat_title": r[4], "target_chat_type": r[5],
                 "target_chat_access_hash": r[6], "user_telegram_id": r[7], "user_username": r[8],
                 "user_first_name": r[9], "user_last_name": r[10], "user_access_hash": r[11]} for r in rows]

async def mark_queue_status(queue_id: int, status: str, error: str = None):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE queue SET status = ?, error = ? WHERE id = ?", (status, error, queue_id))
        await db.commit()

async def mark_invited(user_id: int, target_chat_id: int, user_telegram_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        try:
            await db.execute(
                "INSERT OR IGNORE INTO invited (user_id, target_chat_id, user_telegram_id) VALUES (?, ?, ?)",
                (user_id, target_chat_id, user_telegram_id)
            )
            await db.commit()
        except Exception:
            pass

async def queue_stats(user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute(
            "SELECT status, COUNT(*) FROM queue WHERE user_id = ? GROUP BY status", (user_id,)
        )
        rows = await cursor.fetchall()
        return {r[0]: r[1] for r in rows}

# ---------- КЛАВИАТУРЫ ----------
async def get_main_keyboard(user_id: int):
    is_running = False
    job_id = await get_job_id(user_id)
    if job_id:
        try:
            scheduler.get_job(job_id)
            is_running = True
        except JobLookupError:
            is_running = False
    btn = "⏹ Остановить рассылку" if is_running else "▶️ Запустить рассылку"
    return ReplyKeyboardMarkup(
        keyboard=[
            [KeyboardButton(text="📋 Аккаунты")],
            [KeyboardButton(text="🤝 Партнёрство")],
            [KeyboardButton(text="⚙️ Настройки")],
            [KeyboardButton(text=btn)]
        ],
        resize_keyboard=True
    )

def accounts_keyboard(accounts):
    kb = []
    for acc in accounts:
        status = "✅" if acc['is_active'] else "❌"
        username = acc['username'] if acc['username'] else "без ника"
        display = f"{status} @{username} • {acc['phone']} • 📥{len(acc['sources'])} 📤{len(acc['targets'])}"
        kb.append([KeyboardButton(text=display)])
    kb.append([KeyboardButton(text="➕ Добавить аккаунт")])
    kb.append([KeyboardButton(text="🔙 Назад")])
    return ReplyKeyboardMarkup(keyboard=kb, resize_keyboard=True)

