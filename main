@dp.message(F.text.startswith("✅ "))
async def f_07(m: types.Message):
    await _f_click(m)


@dp.message(F.text.startswith("❌ "))
async def f_08(m: types.Message):
    await _f_click(m)


async def _f_click(m: types.Message):
    parts = m.text.split(" • ")
    if len(parts) < 2:
        return
    phone = parts[1].strip()
    accs = await get_accounts(m.from_user.id)
    acc = next((a for a in accs if a["phone"] == phone), None)
    if not acc:
        await m.answer("Не найден.")
        return
    text = (f"📱 @{acc['username'] or 'без ника'}\n📞 {acc['phone']}\n"
            f"📥 Источников: {len(acc['sources'])}\n"
            f"📤 Цель: {acc['target'].get('title') if acc['target'] else '—'}\n"
            f"📊 Спарсено: {acc['parsed_count']}\n📨 Инвайтов: {acc['invited_count']}")
    await m.answer(text, reply_markup=acc_kb(acc["id"], acc["is_active"]))


@dp.callback_query(F.data.startswith("acc_toggle_"))
async def f_09(cb: types.CallbackQuery):
    acc_id = int(cb.data.split("_")[2])
    acc = await get_account(acc_id, cb.from_user.id)
    if not acc:
        await cb.answer("Не найден.", show_alert=True)
        return
    await toggle_acc(acc_id, cb.from_user.id, not acc["is_active"])
    acc = await get_account(acc_id, cb.from_user.id)
    await cb.answer("Обновлено")
    text = (f"📱 @{acc['username'] or 'без ника'}\n📞 {acc['phone']}\n"
            f"📥 Источников: {len(acc['sources'])}\n"
            f"📤 Цель: {acc['target'].get('title') if acc['target'] else '—'}\n"
            f"📊 Спарсено: {acc['parsed_count']}\n📨 Инвайтов: {acc['invited_count']}")
    try:
        await cb.message.edit_text(text, reply_markup=acc_kb(acc["id"], acc["is_active"]))
    except TelegramBadRequest:
        pass


