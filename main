# ---------- ПАРАМЕТРЫ ИНВАЙТА ----------
INVITE_BATCH = 20             # сколько инвайтов за один батч
INVITE_BATCH_SECONDS = 30     # за сколько секунд (20 за 30 сек)
INVITE_PER_BATCH_DELAY = INVITE_BATCH_SECONDS / INVITE_BATCH  # ~1.5 сек между инвайтами
DEFAULT_INVITE_LIMIT_PER_DAY = 200  # защитный лимит в сутки на аккаунт
DEFAULT_PARSE_LIMIT = 500           # сколько юзеров парсить из одного источника

# ---------- БАЗА ----------
async def init_db():
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute('''
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT,
                partner_id INTEGER,
                invite_limit_per_day INTEGER DEFAULT 200,
                parse_limit INTEGER DEFAULT 500,
                min_delay_seconds REAL DEFAULT 1.5
            )
        ''')
        await db.execute('''
            CREATE TABLE IF NOT EXISTS accounts (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                phone TEXT,
                username TEXT,
                session_string TEXT,
                is_active INTEGER DEFAULT 1,
                invited_count INTEGER DEFAULT 0,
                parsed_count INTEGER DEFAULT 0,
                sources TEXT DEFAULT '[]',
                targets TEXT DEFAULT '[]',
                FOREIGN KEY(user_id) REFERENCES users(user_id)
            )
        ''')
        # очередь распарсенных юзеров на инвайт
        await db.execute('''
            CREATE TABLE IF NOT EXISTS queue (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                source_account_id INTEGER,
                target_account_id INTEGER,
                target_chat_id INTEGER,
                target_chat_title TEXT,
                target_chat_type TEXT,   -- 'channel' или 'chat'
                target_chat_access_hash INTEGER,
                user_telegram_id INTEGER,
                user_username TEXT,
                user_first_name TEXT,
                user_last_name TEXT,
                user_access_hash INTEGER,
                status TEXT DEFAULT 'pending', -- pending / invited / skipped / failed
                error TEXT,
                created_at TEXT DEFAULT CURRENT_TIMESTAMP
            )
        ''')
        # уже приглашённые (глобально)
        await db.execute('''
            CREATE TABLE IF NOT EXISTS invited (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                target_chat_id INTEGER,
                user_telegram_id INTEGER,
                invited_at TEXT DEFAULT CURRENT_TIMESTAMP,
                UNIQUE(user_id, target_chat_id, user_telegram_id)
            )
        ''')
        await db.execute('''
            CREATE TABLE IF NOT EXISTS scheduler_jobs (
                user_id INTEGER PRIMARY KEY,
                job_id TEXT
            )
        ''')
        # миграции
        cursor = await db.execute("PRAGMA table_info(users)")
        cols = {r[1] for r in await cursor.fetchall()}
        for col, sql in [
            ("partner_id", "ALTER TABLE users ADD COLUMN partner_id INTEGER"),
            ("username", "ALTER TABLE users ADD COLUMN username TEXT"),
            ("invite_limit_per_day", "ALTER TABLE users ADD COLUMN invite_limit_per_day INTEGER DEFAULT 200"),
            ("parse_limit", "ALTER TABLE users ADD COLUMN parse_limit INTEGER DEFAULT 500"),
            ("min_delay_seconds", "ALTER TABLE users ADD COLUMN min_delay_seconds REAL DEFAULT 1.5"),
        ]:
            if col not in cols:
                await db.execute(sql)

        cursor = await db.execute("PRAGMA table_info(accounts)")
        cols = {r[1] for r in await cursor.fetchall()}
        for col, sql in [
            ("invited_count", "ALTER TABLE accounts ADD COLUMN invited_count INTEGER DEFAULT 0"),
            ("parsed_count", "ALTER TABLE accounts ADD COLUMN parsed_count INTEGER DEFAULT 0"),
            ("sources", "ALTER TABLE accounts ADD COLUMN sources TEXT DEFAULT '[]'"),
            ("targets", "ALTER TABLE accounts ADD COLUMN targets TEXT DEFAULT '[]'"),
        ]:
            if col not in cols:
                await db.execute(sql)
        await db.commit()

# ---------- CRUD ----------
async def ensure_user(user_id: int, username: str = None):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT user_id FROM users WHERE user_id = ?", (user_id,))
        row = await cursor.fetchone()
        if not row:
            await db.execute(
                "INSERT INTO users (user_id, username, invite_limit_per_day, parse_limit) VALUES (?, ?, ?, ?)",
                (user_id, username, DEFAULT_INVITE_LIMIT_PER_DAY, DEFAULT_PARSE_LIMIT)
            )
        elif username:
            await db.execute("UPDATE users SET username = ? WHERE user_id = ?", (username, user_id))
        await db.commit()

async def find_user_by_username(username: str):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT user_id FROM users WHERE LOWER(username) = LOWER(?)", (username,))
        row = await cursor.fetchone()
        return row[0] if row else None

async def get_partner_id(user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT partner_id FROM users WHERE user_id = ?", (user_id,))
        row = await cursor.fetchone()
        return row[0] if row else None

async def set_partner(user_id: int, partner_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE users SET partner_id = ? WHERE user_id = ?", (partner_id, user_id))
        await db.execute("UPDATE users SET partner_id = ? WHERE user_id = ?", (user_id, partner_id))
        await db.commit()

async def unset_partner(user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT partner_id FROM users WHERE user_id = ?", (user_id,))
        row = await cursor.fetchone()
        partner_id = row[0] if row else None
        await db.execute("UPDATE users SET partner_id = NULL WHERE user_id = ?", (user_id,))
        if partner_id:
            await db.execute("UPDATE users SET partner_id = NULL WHERE user_id = ?", (partner_id,))
        await db.commit()
        return partner_id

async def get_user_settings(user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute(
            "SELECT invite_limit_per_day, parse_limit, min_delay_seconds FROM users WHERE user_id = ?",
            (user_id,)
        )
        row = await cursor.fetchone()
        if row:
            return {"invite_limit_per_day": row[0], "parse_limit": row[1], "min_delay_seconds": row[2]}
        return {"invite_limit_per_day": DEFAULT_INVITE_LIMIT_PER_DAY,
                "parse_limit": DEFAULT_PARSE_LIMIT, "min_delay_seconds": INVITE_PER_BATCH_DELAY}

async def update_user_setting(user_id: int, key: str, value):
    allowed = {"invite_limit_per_day", "parse_limit", "min_delay_seconds"}
    if key not in allowed:
        return
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute(f"UPDATE users SET {key} = ? WHERE user_id = ?", (value, user_id))
        await db.commit()

async def get_accounts(user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute(
            "SELECT id, phone, username, session_string, is_active, invited_count, parsed_count, sources, targets FROM accounts WHERE user_id = ?",
            (user_id,)
        )
        rows = await cursor.fetchall()
        return [{"id": r[0], "phone": r[1], "username": r[2], "session_string": r[3],
                 "is_active": bool(r[4]), "invited_count": r[5], "parsed_count": r[6],
                 "sources": json.loads(r[7] or "[]"), "targets": json.loads(r[8] or "[]")} for r in rows]

async def get_account_by_id(account_id: int, user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute(
            "SELECT id, phone, username, session_string, is_active, invited_count, parsed_count, sources, targets FROM accounts WHERE id = ? AND user_id = ?",
            (account_id, user_id)
        )
        row = await cursor.fetchone()
        if row:
            return {"id": row[0], "phone": row[1], "username": row[2], "session_string": row[3],
                    "is_active": bool(row[4]), "invited_count": row[5], "parsed_count": row[6],
                    "sources": json.loads(row[7] or "[]"), "targets": json.loads(row[8] or "[]")}
        return None

async def add_account(user_id: int, phone: str, username: str, session_string: str):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute(
            "INSERT INTO accounts (user_id, phone, username, session_string) VALUES (?, ?, ?, ?)",
            (user_id, phone, username, session_string)
        )
        await db.commit()
    partner_id = await get_partner_id(user_id)
    if partner_id:
        async with aiosqlite.connect(DB_PATH) as db:
            cursor = await db.execute("SELECT id FROM accounts WHERE user_id = ? AND phone = ?", (partner_id, phone))
            if not await cursor.fetchone():
                await db.execute(
                    "INSERT INTO accounts (user_id, phone, username, session_string) VALUES (?, ?, ?, ?)",
                    (partner_id, phone, username, session_string)
                )
                await db.commit()

