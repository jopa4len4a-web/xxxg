def sources_keyboard(account_id: int, sources: list):
    kb = []
    for i, src in enumerate(sources):
        title = src.get('title', str(src.get('id')))
        kb.append([InlineKeyboardButton(text=f"❌ {title}", callback_data=f"src_del_{account_id}_{i}")])
    kb.append([InlineKeyboardButton(text="📋 Выбрать из чатов", callback_data=f"src_pick_{account_id}")])
    kb.append([InlineKeyboardButton(text="🔙 Назад", callback_data=f"acc_back_{account_id}")])
    return InlineKeyboardMarkup(inline_keyboard=kb)

