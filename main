# ---------- FSM ----------
class AddAccountStates(StatesGroup):
    waiting_phone = State()
    waiting_code = State()
    waiting_password = State()

class PartnershipStates(StatesGroup):
    waiting_username = State()

class ProfileEditStates(StatesGroup):
    waiting_first_name = State()
    waiting_last_name = State()
    waiting_username = State()
    waiting_avatar = State()

class SettingsStates(StatesGroup):
    waiting_invite_limit = State()
    waiting_parse_limit = State()
    waiting_min_delay = State()

# ---------- ПЛАНИРОВЩИК ----------
scheduler = AsyncIOScheduler()

async def save_job_id(user_id: int, job_id: str):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("INSERT OR REPLACE INTO scheduler_jobs (user_id, job_id) VALUES (?, ?)", (user_id, job_id))
        await db.commit()

async def get_job_id(user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT job_id FROM scheduler_jobs WHERE user_id = ?", (user_id,))
        row = await cursor.fetchone()
        return row[0] if row else None

async def delete_job_id(user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("DELETE FROM scheduler_jobs WHERE user_id = ?", (user_id,))
        await db.commit()

# ---------- ПАРСИНГ УЧАСТНИКОВ ----------
async def parse_source_chat(client, source: dict, parse_limit: int):
    """
    Возвращает список словарей {id, username, first_name, last_name, access_hash}
    только с username, без ботов.
    """
    try:
        entity = await client.get_entity(source['id'])
    except Exception:
        try:
            entity = await client.get_entity(source.get('username'))
        except Exception as e:
            logging.error(f"Источник {source.get('title')}: {e}")
            return []

    result = []
    offset = 0
    step = 200
    while len(result) < parse_limit:
        try:
            participants = await client(functions.channels.GetParticipantsRequest(
                channel=entity,
                filter=ChannelParticipantsSearch(''),
                offset=offset, limit=step, hash=0
            )) if isinstance(entity, tl_types.Channel) else None
        except Exception:
            participants = None

        try:
            if participants is None:
                participants = await client(functions.messages.GetParticipantsRequest(
                    peer=entity, filter=ChannelParticipantsSearch(''),
                    offset=offset, limit=step, hash=0
                ))
        except Exception as e:
            logging.warning(f"GetParticipants {source.get('title')}: {e}")
            break

        if not participants or not participants.users:
            break

        for u in participants.users:
            if u.bot:
                continue
            if not getattr(u, 'username', None):
                continue
            result.append({
                'id': u.id,
                'username': u.username,
                'first_name': u.first_name or '',
                'last_name': u.last_name or '',
                'access_hash': u.access_hash,
            })
            if len(result) >= parse_limit:
                break
        offset += step
        if len(participants.users) < step:
            break
    return result

# ---------- ИНВАЙТ ЧЕРЕЗ КОНТАКТ ----------
async def invite_user_via_contact(client, target: dict, u: dict):
    """
    1. Добавляет юзера в контакты.
    2. Инвайтит в целевой чат/канал.
    Возвращает (ok, reason).
    """
    try:
        # 1. Добавляем контакт
        await client(AddContactRequest(
            id=InputPeerUser(u['id'], u['access_hash']),
            first_name=u.get('first_name') or u.get('username') or 'User',
            last_name=u.get('last_name') or '',
            phone='',
            add_phone_privacy_exception=False
        ))
    except FloodWaitError as e:
        await asyncio.sleep(e.seconds)
        return False, f"flood_wait_contact_{e.seconds}s"
    except UserPrivacyRestrictedError:
        return False, "privacy_restricted"
    except Exception as e:
        logging.warning(f"AddContact: {e}")
        # не критично — может быть уже в контактах

    # 2. Инвайт
    try:
        if target['type'] == 'channel':
            await client(InviteToChannelRequest(
                channel=InputPeerChannel(target['id'], target['access_hash']),
                users=[InputPeerUser(u['id'], u['access_hash'])]
            ))
        else:
            await client(AddChatUserRequest(
                chat_id=target['id'],
                user_id=InputPeerUser(u['id'], u['access_hash']),
                fwd_limit=100
            ))
        return True, "invited"
    except UserAlreadyParticipantError:
        return False, "already_participant"
    except UserNotMutualContactError:
        return False, "not_mutual_contact"
    except UserChannelsTooMuchError:
        return False, "target_channels_too_much"
    except ChatAdminRequiredError:
        return False, "no_admin_rights"
    except PeerFloodError:
        return False, "peer_flood"
    except FloodWaitError as e:
        await asyncio.sleep(e.seconds)
        return False, f"flood_wait_invite_{e.seconds}s"
    except Exception as e:
        return False, f"error: {type(e).__name__}: {e}"

# ---------- ГЛАВНЫЙ ПРОЦЕСС (ПАРСИНГ + ИНВАЙТ) ----------
async def process_user(user_id: int):
    """Один проход: парсит источники активных аккаунтов, наполняет очередь, инвайтит батчами."""
    settings = await get_user_settings(user_id)
    accounts = await get_accounts(user_id)
    active = [a for a in accounts if a['is_active']]
    if not active:
        return

    # 1) ПАРСИНГ (с каждого аккаунта его источники)
    for acc in active:
        if not acc['sources'] or not acc['targets']:
            continue
        client = TelegramClient(StringSession(acc['session_string']), API_ID, API_HASH)
        try:
            await client.start()
            total_parsed = 0
            for src in acc['sources']:
                users = await parse_source_chat(client, src, settings['parse_limit'])
                if not users:
                    continue
                # записываем в очередь для каждой цели этого аккаунта
                for tgt in acc['targets']:
                    for u in users:
                        # исключаем тех, кто уже в целевом чате
                        if await is_user_in_chat(client, tgt, u['id']):
                            continue
                        await enqueue_user(
                            user_id, acc['id'], acc['id'],
                            tgt['id'], tgt.get('title', ''), tgt.get('type', 'channel'),
                            tgt.get('access_hash', 0),
                            u['id'], u['username'], u['first_name'], u['last_name'], u['access_hash']
                        )
                        total_parsed += 1
            if total_parsed:
                await increment_account_parsed(acc['id'], user_id, total_parsed)
        except Exception as e:
            logging.error(f"Парсинг [{acc['phone']}]: {e}")
        finally:
            await client.disconnect()

    # 2) ИНВАЙТ (батчами по 20 за 30 секунд)
    batch = await pop_queue_batch(user_id, INVITE_BATCH)
    if not batch:
        return

    # группируем по целевому аккаунту
    by_account = {}
    for item in batch:
        by_account.setdefault(item['target_account_id'], []).append(item)

    for account_id, items in by_account.items():
        acc = next((a for a in active if a['id'] == account_id), None)
        if not acc:
            for it in items:
                await mark_queue_status(it['id'], 'skipped', 'account_inactive')
            continue

        # защитный лимит в сутки
        if acc['invited_count'] >= settings['invite_limit_per_day']:
            for it in items:
                await mark_queue_status(it['id'], 'skipped', 'daily_limit')
            continue

        client = TelegramClient(StringSession(acc['session_string']), API_ID, API_HASH)
        try:
            await client.start()
            for it in items:
                if acc['invited_count'] >= settings['invite_limit_per_day']:
                    await mark_queue_status(it['id'], 'skipped', 'daily_limit')
                    continue
                target = {
                    'id': it['target_chat_id'],
                    'type': it['target_chat_type'],
                    'access_hash': it['target_chat_access_hash'],
                }
                u = {
                    'id': it['user_telegram_id'],
                    'username': it['user_username'],
                    'first_name': it['user_first_name'],
                    'last_name': it['user_last_name'],
                    'access_hash': it['user_access_hash'],
                }
                ok, reason = await invite_user_via_contact(client, target, u)
                if ok:
                    await mark_queue_status(it['id'], 'invited')
                    await mark_invited(user_id, it['target_chat_id'], it['user_telegram_id'])
                    await increment_account_invited(account_id, user_id, 1)
                    acc['invited_count'] += 1
                else:
                    if reason in ("already_participant", "not_mutual_contact",
                                  "target_channels_too_much", "privacy_restricted",
                                  "no_admin_rights", "peer_flood"):
                        await mark_queue_status(it['id'], 'skipped', reason)
                        await mark_invited(user_id, it['target_chat_id'], it['user_telegram_id'])
                    else:
                        await mark_queue_status(it['id'], 'failed', reason)
                await asyncio.sleep(settings['min_delay_seconds'])
        except Exception as e:
            logging.error(f"Инвайт [{acc['phone']}]: {e}")
            for it in items:
                await mark_queue_status(it['id'], 'failed', str(e))
        finally:
            await client.disconnect()

async def is_user_in_chat(client, target: dict, user_id_tg: int):
    try:
        entity = await client.get_entity(target['id'])
        await client(functions.channels.GetParticipantRequest(channel=entity, participant=user_id_tg))
        return True
    except Exception:
        return False

