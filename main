@dp.callback_query(F.data.startswith("src_add_"))
async def f_15(cb: types.CallbackQuery, st: FSMContext):
    parts = cb.data.split("_")
    acc_id = int(parts[2])
    idx = int(parts[3])
    data = await st.get_data()
    dialogs = data.get("dialogs", [])
    if not (0 <= idx < len(dialogs)):
        await cb.answer("Ошибка.", show_alert=True)
        return
    acc = await get_account(acc_id, cb.from_user.id)
    if not acc:
        await cb.answer("Не найден.", show_alert=True)
        return
    new = dialogs[idx]
    srcs = acc["sources"]
    if not any(s["id"] == new["id"] for s in srcs):
        srcs.append(new)
        await save_sources(acc_id, cb.from_user.id, srcs)
    await cb.answer(f"+ {new['title']}")
    text = "📥 Источники:\n" + "\n".join(f"{i+1}. {s.get('title')}" for i, s in enumerate(srcs))
    try:
        await cb.message.edit_text(text, reply_markup=src_kb(acc_id, srcs))
    except TelegramBadRequest:
        pass


@dp.callback_query(F.data.startswith("src_del_"))
async def f_16(cb: types.CallbackQuery):
    parts = cb.data.split("_")
    acc_id = int(parts[2])
    idx = int(parts[3])
    acc = await get_account(acc_id, cb.from_user.id)
    if not acc:
        await cb.answer("Не найден.", show_alert=True)
        return
    srcs = acc["sources"]
    if 0 <= idx < len(srcs):
        srcs.pop(idx)
        await save_sources(acc_id, cb.from_user.id, srcs)
    await cb.answer("Удалено")
    text = "📥 Источники:\n" + ("\n".join(f"{i+1}. {s.get('title')}" for i, s in enumerate(srcs))
                                if srcs else "Пусто.")
    try:
        await cb.message.edit_text(text, reply_markup=src_kb(acc_id, srcs))
    except TelegramBadRequest:
        pass


