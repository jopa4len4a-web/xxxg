        await cb.answer("Не найден.", show_alert=True)
        return
    info = "✏️ Настройки профиля\n\n"
    client = make_client(acc["session_string"])
    try:
        await client.start()
        me = await client.get_me()
        info += (f"👤 Имя: {me.first_name or '—'}\n📛 Фамилия: {me.last_name or '—'}\n"
                 f"🔗 Юзернейм: @{me.username if me.username else '—'}\n"
                 f"📞 Телефон: {me.phone or acc['phone']}")
    except Exception as e:
        info += f"Ошибка: {e}"
    finally:
        try:
            await client.disconnect()
        except Exception:
            pass
    try:
        await cb.message.edit_text(info, reply_markup=prof_kb(acc_id))
    except TelegramBadRequest:
        pass
    await cb.answer()


