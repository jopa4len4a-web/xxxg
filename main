@dp.message(S_prof.first)
async def f_23(m: types.Message, st: FSMContext):
    name = m.text.strip()
    if not name or len(name) > 64:
        await m.answer("Имя 1–64 символа.")
        return
    data = await st.get_data()
    acc = await get_account(data["acc_id"], m.from_user.id)
    client = make_client(acc["session_string"])
    try:
        await client.start()
        me = await client.get_me()
        last = me.last_name if me.last_name else None
        await client(UpdateProfileRequest(first_name=name, last_name=last))
        await m.answer(f"✅ Имя: {name}")
    except FloodWaitError as e:
        await m.answer(f"Подожди {e.seconds} сек.")
    except Exception as e:
        await m.answer(f"❌ {e}")
    finally:
        try:
            await client.disconnect()
        except Exception:
            pass
    await st.clear()


