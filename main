    await st.set_state(S_prof.avatar)
    await cb.answer()


@dp.message(S_prof.avatar, F.photo | F.text)
async def f_29(m: types.Message, st: FSMContext):
    data = await st.get_data()
    acc = await get_account(data["acc_id"], m.from_user.id)
    if not acc:
        await m.answer("Не найден.")
        await st.clear()
        return
    client = make_client(acc["session_string"])
    try:
        await client.start()
        if m.text and m.text.strip() == "-":
            photos = await client(GetUserPhotosRequest(user_id="me", offset=0, max_id=0, limit=100))
            if photos.photos:
                await client(DeletePhotosRequest(id=photos.photos))
            await m.answer("✅ Аватар удалён.")
        elif m.photo:
            file = await m.bot.get_file(m.photo[-1].file_id)
            path = f"/tmp/av_{data['acc_id']}_{m.message_id}.jpg"
            await m.bot.download_file(file.file_path, path)
            try:
                up = await client.upload_file(path)
                await client(UploadProfilePhotoRequest(file=up))
                await m.answer("✅ Аватар установлен.")
            finally:
                try:
                    os.remove(path)
                except Exception:
                    pass
        else:
            await m.answer("Отправь фото или «-».")
            return
    except FloodWaitError as e:
        await m.answer(f"Подожди {e.seconds} сек.")
    except Exception as e:
        await m.answer(f"❌ {e}")
    finally:
        try:
            await client.disconnect()
        except Exception:
            pass
    await st.clear()


@dp.message(F.text == "🤝 Партнёрство")
async def f_30(m: types.Message):
    await ensure_user(m.from_user.id, m.from_user.username)
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT partner_id FROM users WHERE user_id = ?", (m.from_user.id,))
        r = await cur.fetchone()
    pid = r[0] if r else None
    if pid:
        async with aiosqlite.connect(DB_PATH) as db:
            cur = await db.execute("SELECT username FROM users WHERE user_id = ?", (pid,))
            pr = await cur.fetchone()
        pn = f"@{pr[0]}" if pr and pr[0] else f"id{pid}"
        text = f"🤝 Партнёр: {pn}\n\nНовые аккаунты автоматически передаются партнёру."
    else:
        text = "🤝 Партнёр не привязан.\n\nПосле привязки новые аккаунты будут копироваться партнёру."
    await m.answer(text, reply_markup=partner_kb(bool(pid)))


@dp.callback_query(F.data == "partner_link")
async def f_31(cb: types.CallbackQuery, st: FSMContext):
    await cb.message.answer("Введите @username партнёра (он должен был запускать бота).")
    await st.set_state(S_partner.username)
    await cb.answer()


@dp.callback_query(F.data == "partner_unset")
async def f_32(cb: types.CallbackQuery):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT partner_id FROM users WHERE user_id = ?", (cb.from_user.id,))
        r = await cur.fetchone()
        pid = r[0] if r else None
        await db.execute("UPDATE users SET partner_id = NULL WHERE user_id = ?", (cb.from_user.id,))
        if pid:
            await db.execute("UPDATE users SET partner_id = NULL WHERE user_id = ?", (pid,))
        await db.commit()
    try:
        await cb.message.edit_text("❌ Партнёрство расторгнуто.")
    except TelegramBadRequest:
        pass
    if pid:
        try:
            await cb.bot.send_message(pid, "❌ Ваш партнёр расторг партнёрство.")
        except Exception:
            pass
    await cb.answer()


@dp.message(S_partner.username)
async def f_33(m: types.Message, st: FSMContext):
    un = m.text.strip().lstrip("@")
    if not un:
        await m.answer("Введите @username.")
        return
    tid = await find_user(un)
    if not tid:
        await m.answer(f"❌ @{un} не найден. Он должен нажать /start.")
        await st.clear()
        return
    if tid == m.from_user.id:
        await m.answer("❌ Нельзя привязать себя.")
        await st.clear()
        return
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT partner_id FROM users WHERE user_id = ?", (tid,))
        r = await cur.fetchone()
        if r and r[0]:
            await m.answer(f"❌ У @{un} уже есть партнёр.")
            await st.clear()
            return
        await db.execute("UPDATE users SET partner_id = ? WHERE user_id = ?", (tid, m.from_user.id))
        await db.execute("UPDATE users SET partner_id = ? WHERE user_id = ?", (m.from_user.id, tid))
        await db.commit()
    await m.answer(f"✅ Партнёрство с @{un} установлено.")
    try:
        await m.bot.send_message(tid, "🤝 С вами установили партнёрство аккаунтов.")
    except Exception:
        pass
    await st.clear()


